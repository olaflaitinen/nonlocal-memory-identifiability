# Purpose: Citation metadata of the software, in the Citation File Format, so
# that the repository can be cited alongside the manuscript.
# Manuscript: supports the code availability statement.
# Inputs: none. Outputs: metadata consumed by citation tools and by Zenodo.

# Version of the Citation File Format used by this file.
cff-version: 1.2.0
# Message shown by citation tools when the software is cited.
message: "If you use this software, please cite it using the metadata below."
# Title of the software, which names the accompanying manuscript.
title: "nonlocal-memory-identifiability: code for identifiability of perception and memory in nonlocal advection-diffusion models of animal movement"
# The cited work is software rather than an article.
type: software
# Most recent archived version, a development snapshot rather than the version
# that produces the numerical results of the manuscript. That version will be
# released as 1.0.0 once the experiments have been run.
version: 0.1.0
# Licence of the source code, expressed as an SPDX identifier.
license: MPL-2.0
# Location of the source code repository.
repository-code: "https://github.com/olaflaitinen/nonlocal-memory-identifiability"
# Concept identifier of the software, cited until version 1.0.0 is released.
doi: "10.5281/zenodo.22804041"
# Persistent identifiers minted by the archive for this software.
identifiers:
  # Identifier that always resolves to the most recent archived version.
  - type: doi
    # Concept identifier of the software, covering every archived version.
    value: "10.5281/zenodo.22804041"
    # Description shown by citation tools beside the identifier.
    description: "Concept identifier of all archived versions"
  # Identifier of a snapshot taken before any experiment of the manuscript was run.
  - type: doi
    # Version identifier of the development snapshot 0.1.0.
    value: "10.5281/zenodo.22804930"
    # Description shown by citation tools beside the identifier.
    description: "Development snapshot 0.1.0, archived before any experiment was run"
  # Identifier of the earlier snapshot, also taken before any experiment was run.
  - type: doi
    # Version identifier of the development snapshot 0.0.1.
    value: "10.5281/zenodo.22804042"
    # Description shown by citation tools beside the identifier.
    description: "Development snapshot 0.0.1, archived before any experiment was run"
# Authors of the software.
authors:
  # Sole author of the software and of the accompanying manuscript.
  - family-names: "Laitinen Imanov"
    # Given names of the author, as they appear in the manuscript.
    given-names: "Olaf Yunus"
    # Persistent identifier of the author.
    orcid: "https://orcid.org/0009-0006-5184-0810"
    # Affiliation of the author at the time of the work.
    affiliation: "Department of Mathematics and Statistics, University of Helsinki"
    # Electronic mail address of the corresponding author.
    email: "yunus.imanov@helsinki.fi"
# Free text keywords used by citation tools and by archives.
keywords:
  # Class of partial differential equations implemented by the software.
  - nonlocal advection-diffusion
  # Central question addressed by the software.
  - structural identifiability
  # Cognitive mechanism represented by the model.
  - spatial memory
  # Application domain of the model.
  - animal movement
  # Statistical framework used for the inference.
  - Bayesian inference
# The article that the software accompanies, cited in preference to the software.
preferred-citation:
  # The preferred citation is a journal article.
  type: article
  # Title of the article.
  title: "Structural and practical identifiability of perception and memory in nonlocal advection-diffusion models of animal movement"
  # Authors of the article.
  authors:
    # Sole author of the article.
    - family-names: "Laitinen Imanov"
      # Given names of the author, as they appear in the manuscript.
      given-names: "Olaf Yunus"
      # Persistent identifier of the author.
      orcid: "https://orcid.org/0009-0006-5184-0810"
      # Affiliation of the author at the time of the work.
      affiliation: "Department of Mathematics and Statistics, University of Helsinki"
  # Journal to which the article is submitted.
  journal: "Journal of Mathematical Biology"
  # Publication status of the article, to be updated on publication.
  notes: "In preparation. The volume, pages and digital object identifier are added on publication."
  # Year in which the work was prepared.
  year: 2026
