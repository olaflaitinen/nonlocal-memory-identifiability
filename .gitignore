# Purpose: Exclude local data, generated raw results and environment artefacts
# from version control, while keeping the tracked documentation and summary
# outputs of the repository.
# Manuscript: supports the data policy of Section 4.5 and the reproducibility
# instructions of docs/reproducibility.md.

# Raw data package files are downloaded by the user and are never committed.
data/*
# The data documentation is tracked because it carries the citation and licence.
!data/README.md
# The checksum manifest is tracked so that downloads can be verified.
!data/checksums.sha256

# Raw experiment output is large and is regenerated by the experiment scripts.
results/raw/
# Sampler checkpoints are large binary files that are regenerated on resume.
checkpoints/
# Outputs of the smoke configuration, which are a demonstration and not results.
results/summary/smoke_*
# Generated figures are rebuilt from the tracked summaries.
results/figures/*
# The placeholder keeps the empty figure directory in the working tree.
!results/figures/.gitkeep
# Generated tables are rebuilt from the tracked summaries.
results/tables/*
# The placeholder keeps the empty table directory in the working tree.
!results/tables/.gitkeep

# Slurm writes one log file per array task into this directory.
slurm/logs/
# Slurm default output files created when no log directory is configured.
slurm-*.out
# Slurm default error files created when no log directory is configured.
slurm-*.err

# Byte compiled Python modules.
__pycache__/
# Compiled Python files of any interpreter version.
*.py[cod]
# Build directories produced by the packaging backend.
build/
# Distribution archives produced by the packaging backend.
dist/
# Metadata directories produced by an editable installation.
*.egg-info/
# Cache of the pytest test runner.
.pytest_cache/
# Cache of the ruff linter.
.ruff_cache/
# Cache of the mypy type checker, if it is used locally.
.mypy_cache/
# Cache of the numba ahead of time compiler.
__pycache__.nbi
# Local virtual environments created by venv or conda.
.venv/
# Alternative name for a local virtual environment.
venv/
# Conda environment directories created inside the repository.
envs/
# Coverage reports produced by the test runner.
.coverage
# Editor state of Visual Studio Code.
.vscode/
# Editor state of the JetBrains family of editors.
.idea/
# Swap files created by vim.
*.swp
# Backup files created by several editors.
*~
# Metadata files created by macOS Finder.
.DS_Store
